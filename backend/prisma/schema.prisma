generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  firebaseUid          String                @unique
  email                String                @unique
  name                 String
  role                 String                @default("user")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  appointments            Appointment[]
  lawyerProfile           Lawyer?
  caseFiles               CaseFile[]
  notifications           Notification[]
  googleCalendarToken     GoogleCalendarToken?
  consultationMessages    ConsultationMessage[]
}

model Lawyer {
  id               String        @id @default(uuid())
  userId           String        @unique
  specialization   String[]
  location         String?
  bio              String?
  isVerified       Boolean       @default(false)
  hourlyRate       Float?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  idPhotos         String[]
  phone            String?
  phoneVerified    Boolean       @default(false)
  profileCompleted Boolean       @default(false)
  profilePicture   String?
  workExperience   String?
  rejectedReason   String?
  appointments     Appointment[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id               String             @id @default(uuid())
  userId           String
  lawyerId         String
  scheduledAt      DateTime
  status           String             @default("pending")
  caseDescription  String
  meetingLink      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lawyer           Lawyer             @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseFiles        CaseFile[]
  payments         Payment[]
  consultationRoom ConsultationRoom?
}

// ─── Case File / Document Storage ───────────────────────────────
model CaseFile {
  id            String      @id @default(uuid())
  name          String                              // original filename
  url           String                              // storage URL (S3 / Firebase Storage)
  fileType      String?                             // mime type, e.g. "application/pdf"
  fileSize      Int?                                // size in bytes
  uploadedBy    String      @default("client")      // "client" | "lawyer"
  userId        String                              // who uploaded it
  appointmentId String?                             // optional link to a specific appointment
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

// ─── Payment / Transaction ──────────────────────────────────────
model Payment {
  id               String      @id @default(uuid())
  appointmentId    String
  amount           Float                             // amount in LKR
  currency         String      @default("LKR")
  status           String      @default("pending")   // "pending" | "succeeded" | "failed" | "refunded"
  stripeSessionId  String?     @unique               // Stripe checkout session ID
  stripePaymentId  String?                            // Stripe payment intent ID
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// ─── Notification ───────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")               // "info" | "success" | "warning" | "payment" | "booking"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Google Calendar OAuth Tokens ───────────────────────────────
model GoogleCalendarToken {
  id           String   @id @default(uuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Video Consultation Room ─────────────────────────────────────
model ConsultationRoom {
  id               String                @id @default(uuid())
  appointmentId    String                @unique
  status           String                @default("waiting")  // "waiting" | "active" | "ended"
  startedAt        DateTime?
  endedAt          DateTime?
  lawyerJoinedAt   DateTime?
  clientJoinedAt   DateTime?
  summaryJson      String?               // JSON string of AI-generated summary
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  appointment      Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  messages         ConsultationMessage[]
}

// ─── Consultation Chat Messages ──────────────────────────────────
model ConsultationMessage {
  id           String           @id @default(uuid())
  roomId       String
  senderUserId String
  senderRole   String           // "lawyer" | "client"
  text         String
  createdAt    DateTime         @default(now())
  room         ConsultationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
}
